---
import { site } from "@/config/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-navy-800 bg-navy-900 text-navy-100">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Brand -->
    <div class="lg:col-span-2">
      <a href="#top" class="text-xl font-bold text-white">{site.name}</a>
      <p class="mt-3 max-w-sm text-sm leading-relaxed">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Reliable transport and logistics
        across Southern Africa.
      </p>
      <div class="mt-5 h-1 w-12 rounded bg-yellow-brand"></div>
    </div>

    <!-- Quick links -->
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-white">Quick Links</p>
      <ul class="mt-4 space-y-2 text-sm">
        {site.nav.map((item) => (
          <li>
            <a href={item.href} class="transition-colors hover:text-sky-brand">{item.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-white">Contact Us</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a href={site.phone.href} class="transition-colors hover:text-sky-brand">{site.phone.display}</a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="break-all transition-colors hover:text-sky-brand">{site.email}</a>
        </li>
        <li>{site.address}</li>
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-navy-800">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 py-5 text-sm sm:flex-row">
      <p>© {year} {site.name}. All rights reserved.</p>
      <a href="#top" class="inline-flex items-center gap-2 transition-colors hover:text-yellow-brand">
        Back to top
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
        </svg>
      </a>
    </div>
  </div>
</footer>