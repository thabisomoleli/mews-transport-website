---
import { site } from "@/config/site";
---

<header class="sticky top-0 z-50 border-b border-navy-100 bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4">
    <a href="#top" class="text-xl font-bold text-navy-900">{site.name}</a>

    <!-- Mobile menu button -->
    <button
      id="menu-button"
      type="button"
      class="rounded-md p-2 text-navy-900 lg:hidden"
      aria-controls="main-nav"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Navigation -->
    <nav
      id="main-nav"
      class="absolute inset-x-0 top-full hidden border-b border-navy-100 bg-white px-4 pb-4 shadow-md lg:static lg:block lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none"
    >
      <ul class="flex flex-col gap-4 pt-4 lg:flex-row lg:gap-8 lg:pt-0">
        {site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              data-nav-link
              class="relative block py-1 font-medium text-navy-800 transition-colors hover:text-sky-brand"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById("menu-button");
  const nav = document.getElementById("main-nav");
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

  // Open/close the mobile menu
  function setMenu(open: boolean) {
    nav?.classList.toggle("hidden", !open);
    button?.setAttribute("aria-expanded", String(open));
    button?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  }

  button?.addEventListener("click", () => {
    setMenu(nav?.classList.contains("hidden") ?? false);
  });

  // Close the menu after tapping a link (mobile)
  links.forEach((link) => link.addEventListener("click", () => setMenu(false)));

  // Highlight the link for the section currently on screen
  const sections = document.querySelectorAll<HTMLElement>("main section[id]");

  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((link) => {
          const active = link.hash === `#${entry.target.id}`;
          link.classList.toggle("text-sky-brand", active);
          link.classList.toggle("font-semibold", active);
        });
      });
    },
    { rootMargin: "-50% 0px -50% 0px" }
  );

  sections.forEach((section) => spy.observe(section));
</script>