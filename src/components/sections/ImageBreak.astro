---
import { Image } from "astro:assets";
import breakImage from "@/assets/images/break-convoy.jpg";
import Button from "@/components/ui/Button.astro";
---

<section class="relative isolate flex min-h-[90svh] items-start overflow-hidden bg-navy-50">
  <!-- Background photo -->
  <Image
    src={breakImage}
    alt="Convoy of Mews Transport trucks on a misty highway"
    class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
    widths={[640, 1024, 1536, 1920]}
    sizes="100vw"
    loading="lazy"
  />

  <!-- Top fade: blends from the light Services section into the mist -->
  <div class="absolute inset-x-0 top-0 -z-10 h-1/2 bg-gradient-to-b from-navy-50 via-navy-50/70 to-transparent"></div>

  <!-- Bottom fade: blends from the photo into the navy Contact section -->
  <div class="absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-gradient-to-t from-navy-900 to-transparent"></div>

  <div class="mx-auto w-full max-w-7xl px-4 pt-16 text-center sm:pt-20">
    <p class="font-semibold uppercase tracking-widest text-sky-brand" data-reveal="up">
      Across Southern Africa
    </p>

    <h2 class="mx-auto mt-4 max-w-3xl text-4xl font-bold text-navy-900 sm:text-6xl" data-reveal="zoom" style="--delay: 150ms">
      Any road. Any weather. Delivered.
    </h2>

    <p class="mx-auto mt-6 max-w-xl text-lg text-navy-800" data-reveal="up" style="--delay: 300ms">
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vestibulum id ligula porta felis euismod semper.
    </p>

    <div class="mt-10" data-reveal="up" style="--delay: 450ms">
      <Button href="#contact">Talk to us</Button>
    </div>
  </div>
</section>