---
import { Image } from "astro:assets";
import servicesImage from "@/assets/images/services-silo.jpg";
import { services } from "@/data/services";
---

<section id="services" class="overflow-hidden bg-navy-50 py-24">
  <div class="mx-auto grid w-full max-w-7xl gap-12 px-4 lg:grid-cols-[3fr_2fr]">
    <!-- Right on desktop (first on mobile): heading + photo, stays in view while the cards scroll -->
    <div class="lg:sticky lg:top-24 lg:order-2 lg:self-start">
      <p class="font-semibold uppercase tracking-wide text-sky-brand" data-reveal="right">
        What we do
      </p>
      <h2 class="mt-2 text-3xl font-bold text-navy-900 sm:text-4xl" data-reveal="right" style="--delay: 150ms">
        Our Services
      </h2>
      <p class="mt-4 text-lg text-gray-600" data-reveal="right" style="--delay: 300ms">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Curabitur blandit tempus porttitor.
        Nulla vitae elit libero, a pharetra augue.
      </p>

      <div class="relative mt-10 hidden sm:block" data-reveal="right" style="--delay: 400ms">
        <!-- Yellow accent block behind the photo -->
        <div class="absolute -bottom-4 -right-4 h-full w-full rounded-2xl bg-yellow-brand"></div>
        <Image
          src={servicesImage}
          alt="Mews Transport truck leaving an industrial site with grain silos"
          class="relative aspect-[4/5] w-full rounded-2xl object-cover object-bottom shadow-xl"
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 35vw, 90vw"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Left on desktop: service cards -->
    <div class="grid gap-6 sm:grid-cols-2 lg:order-1">
      {services.map((service, i) => (
        <article
          class="group relative overflow-hidden rounded-2xl border border-navy-100 bg-white p-8 transition-shadow duration-500 hover:shadow-xl"
          data-reveal="up"
          style={`--delay: ${(i % 2) * 150}ms`}
        >
          <!-- Yellow bar that sweeps in on hover -->
          <div class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-yellow-brand transition-transform duration-500 group-hover:scale-x-100"></div>

          <span class="text-sm font-bold text-sky-brand">
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-3 text-xl font-semibold text-navy-900">{service.title}</h3>
          <p class="mt-3 text-gray-600">{service.summary}</p>

          <ul class="mt-6 space-y-2 border-t border-navy-100 pt-6">
            {service.features.map((feature) => (
              <li class="flex items-center gap-3 text-sm text-navy-800">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-yellow-brand"></span>
                {feature}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>