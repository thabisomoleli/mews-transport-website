---
import { site } from "@/config/site";
import Button from "@/components/ui/Button.astro";

const contacts = [
  { label: "Phone", value: site.phone.display, href: site.phone.href },
  { label: "Email", value: site.email, href: `mailto:${site.email}` },
  { label: "Address", value: site.address, href: undefined },
];
---

<section id="contact" class="overflow-hidden bg-navy-900 py-24">
  <div class="mx-auto w-full max-w-7xl px-4">
    <!-- Heading -->
    <div class="max-w-2xl">
      <p class="font-semibold uppercase tracking-wide text-yellow-brand" data-reveal="left">
        Contact
      </p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl" data-reveal="left" style="--delay: 150ms">
        Let's move your cargo
      </h2>
      <p class="mt-4 text-lg text-navy-100" data-reveal="up" style="--delay: 300ms">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Call or email us and we'll respond
        as soon as possible.
      </p>
    </div>

    <!-- Contact cards -->
    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {contacts.map((item, i) => {
        const Tag = item.href ? "a" : "div";
        return (
          <Tag
            href={item.href}
            class:list={[
              "rounded-2xl border border-navy-700 bg-navy-800 p-6",
              item.href && "transition hover:border-sky-brand hover:bg-navy-700",
            ]}
            data-reveal="zoom"
            style={`--delay: ${400 + i * 150}ms`}
          >
            <p class="text-sm font-semibold uppercase tracking-wide text-sky-brand">{item.label}</p>
            <p class="mt-2 break-all text-lg font-semibold text-white">{item.value}</p>
          </Tag>
        );
      })}
    </div>

    <!-- Buttons -->
    <div class="mt-12 flex flex-wrap gap-4" data-reveal="up" style="--delay: 850ms">
      <Button href={`mailto:${site.email}?subject=Quote%20request`}>Get a quote</Button>
      <Button href={`mailto:${site.email}?subject=Website%20enquiry`} variant="outline-light">
        Send an enquiry
      </Button>
    </div>
  </div>
</section>