---
import { site } from "@/config/site";
import Button from "@/components/ui/Button.astro";

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.address)}&output=embed`;
---

<section id="contact" class="overflow-hidden bg-navy-900 py-24">
  <div class="mx-auto w-full max-w-7xl px-4">
    <!-- Heading -->
    <div class="max-w-2xl">
      <p class="font-semibold uppercase tracking-wide text-yellow-brand" data-reveal="left">
        Contact
      </p>
      <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl" data-reveal="left" style="--delay: 150ms">
        Let's move your cargo
      </h2>
      <p class="mt-4 text-lg text-navy-100" data-reveal="up" style="--delay: 300ms">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Call or email us and we'll respond
        as soon as possible.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <!-- Box 1: contact info -->
      <div
        class="flex flex-col justify-between rounded-2xl border border-navy-700 bg-navy-800 p-8"
        data-reveal="left"
        style="--delay: 400ms"
      >
        <ul class="space-y-6">
          <li>
            <p class="text-sm font-semibold uppercase tracking-wide text-sky-brand">Phone</p>
            <a href={site.phone.href} class="mt-1 block text-lg font-semibold text-white hover:text-yellow-brand">
              {site.phone.display}
            </a>
          </li>
          <li>
            <p class="text-sm font-semibold uppercase tracking-wide text-sky-brand">Email</p>
            <a href={`mailto:${site.email}`} class="mt-1 block break-all text-lg font-semibold text-white hover:text-yellow-brand">
              {site.email}
            </a>
          </li>
          <li>
            <p class="text-sm font-semibold uppercase tracking-wide text-sky-brand">Address</p>
            <p class="mt-1 text-lg font-semibold text-white">{site.address}</p>
          </li>
        </ul>

        <div class="mt-10 flex flex-wrap gap-4">
          <Button href={`mailto:${site.email}?subject=Quote%20request`}>Get a quote</Button>
          <Button href={`mailto:${site.email}?subject=Website%20enquiry`} variant="outline-light">
            Send an enquiry
          </Button>
        </div>
      </div>

      <!-- Box 2: map -->
      <div
        class="overflow-hidden rounded-2xl border border-navy-700 bg-navy-800"
        data-reveal="right"
        style="--delay: 550ms"
      >
        <iframe
          src={mapSrc}
          title={`Map showing ${site.name}'s location`}
          class="h-full min-h-[350px] w-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>