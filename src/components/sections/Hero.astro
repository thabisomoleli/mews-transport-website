---
import { Image } from "astro:assets";
import heroImage from "@/assets/images/hero-trucks.jpg";
import { site } from "@/config/site";
import Button from "@/components/ui/Button.astro";
---

  <section id="top" class="relative isolate flex min-h-[calc(100svh-4.5rem)] items-center overflow-hidden bg-navy-900">
  <!-- Background photo -->
  <Image
    src={heroImage}
    alt="Fleet of Mews Transport trucks parked in a row"
    class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40"
    widths={[640, 1024, 1536]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Dark gradient so text stays readable -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-900 via-navy-900/70 to-transparent"></div>

  <div class="mx-auto w-full max-w-7xl px-4 py-16">
    <p class="font-semibold uppercase tracking-widest text-yellow-brand" data-reveal="left">
      Mews Transport
    </p>

    <h1 class="mt-4 max-w-2xl text-4xl font-bold text-white sm:text-6xl" data-reveal="up" style="--delay: 150ms">
      Reliable transport and logistics you can count on
    </h1>

    <p class="mt-6 max-w-xl text-lg text-navy-100" data-reveal="up" style="--delay: 300ms">
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere erat a ante venenatis dapibus.
    </p>

    <div class="mt-10 flex flex-wrap gap-4" data-reveal="up" style="--delay: 450ms">
      <Button href={`mailto:${site.email}?subject=Quote%20request`}>Get a quote</Button>
      <Button href="#services" variant="outline-light">Our services</Button>
    </div>
  </div>
</section>