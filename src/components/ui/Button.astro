---
interface Props {
  href: string;
  variant?: "primary" | "outline" | "outline-light";
  class?: string;
}

const { href, variant = "primary", class: className } = Astro.props;

const variants = {
  primary: "bg-yellow-brand text-navy-900 hover:brightness-95",
  outline: "border border-navy-800 text-navy-800 hover:bg-navy-50",
  "outline-light": "border border-white text-white hover:bg-white/10",
};
---

<a
  href={href}
  class:list={[
    "inline-block rounded-lg px-6 py-3 font-semibold transition",
    variants[variant],
    className,
  ]}
>
  <slot />
</a>